{
  "name": "mmg-visualizemm",
  "version": "0.1.0",
  "private": true,
  "description": "面向数学建模新手的「AI 辅助读题 + 自主建模」辅导工具（开源自托管 + BYOK）",
  "type": "module",
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "dev:web": "vite --config web/vite.config.js",
    "dev:server": "node --use-system-ca server/index.js",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test tests/problem-text.test.js",
    "test:api": "node --test tests/api/workspaces-api.test.js",
    "test:golden": "node --test tests/golden-fixtures.test.js",
    "test:browser": "npm run build && playwright test --config playwright.config.js",
    "eval:role": "node scripts/eval/role-classification.mjs",
    "generate:card-library": "node scripts/generate/card-library.mjs",
    "generate:golden-fixtures": "node scripts/generate/golden-original-fixtures.mjs",
    "generate:golden-open-data": "node scripts/generate/golden-open-data-fixtures.mjs",
    "check:syntax": "node --check server/index.js && node --check server/knowledge.js && node --check server/upstream.js",
    "check": "npm run test && npm run check:syntax && npm run build",
    "start": "node --use-system-ca server/index.js",
    "dev": "concurrently -n WEB,SRV -c blue,green \"npm:dev:web\" \"npm:dev:server\""
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "katex": "^0.18.4",
    "marked": "^18.0.11",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
