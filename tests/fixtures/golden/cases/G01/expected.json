{
  "schemaVersion": 1,
  "caseId": "G01",
  "input": {
    "requiredFiles": ["problem.md", "attachments/建筑方案.csv"],
    "assertions": [{ "id": "design-count", "kind": "equals", "description": "改编 CSV 包含 12 个可追溯方案", "target": "attachments/建筑方案.csv.rows", "expected": 12, "blocking": true }]
  },
  "understanding": {
    "roles": [
      { "quote": "请按以下透明规则评价：相对紧凑度是效益型指标，权重 0.20；采暖负荷和制冷负荷是成本型指标，权重各 0.40。", "role": "given" },
      { "quote": "综合得分越高越优。", "role": "objective" },
      { "quote": "若某指标极差为 0，则该项标准化值统一记为 1。", "role": "constraint" }
    ],
    "requiredPoints": ["识别一个效益型和两个成本型指标", "权重和为 1", "只在 12 个候选方案上标准化", "source_row 仅用于追溯", "敏感性场景重新计算"]
  },
  "evidence": [{ "problemQuote": "附件“建筑方案.csv”改编自 UCI Energy Efficiency 数据集", "file": "attachments/建筑方案.csv", "fields": ["design_id", "source_row", "relative_compactness", "heating_load", "cooling_load"] }],
  "modeling": {
    "requiredConcepts": ["指标方向", "极差标准化", "加权得分", "完整排序", "权重敏感性"],
    "acceptableAlternatives": ["可保留更多小数位，排序和硬约束满足容差即可"],
    "forbiddenClaims": ["把采暖或制冷负荷当作效益型", "把 source_row 纳入得分", "把教学权重说成原数据作者结论"],
    "risks": ["固定权重反映决策偏好", "候选集抽样会影响极差和排序", "模拟负荷不等于真实运营能耗"]
  },
  "execution": {
    "assertions": [
      { "id": "row-count", "kind": "equals", "description": "基线读取 12 个方案", "target": "baseline.rowCount", "expected": 12, "blocking": true },
      { "id": "weight-sum", "kind": "equals", "description": "主场景权重和为 1", "target": "baseline.weightSum", "expected": 1, "blocking": true },
      { "id": "original-top-three", "kind": "equals", "description": "主场景前三名为 D01、D03、D09", "target": "baseline.originalTopThree", "expected": ["D01", "D03", "D09"], "blocking": true },
      { "id": "sensitivity-top-three", "kind": "equals", "description": "移除紧凑度后前三名为 D03、D09、D06", "target": "baseline.sensitivityTopThree", "expected": ["D03", "D09", "D06"], "blocking": true }
    ],
    "requiredOutputs": ["text", "table", "plot", "saved-workspace"],
    "tolerances": { "score": 0.000001 }
  },
  "blockers": ["无法读取 CSV", "指标方向或权重错误", "排名无法追溯到原始行", "敏感性场景没有重新标准化和排序"]
}
