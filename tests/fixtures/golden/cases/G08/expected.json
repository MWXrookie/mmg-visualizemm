      { "id": "known-groups", "kind": "equals", "description": "逐设备留出共有 12 组", "target": "baseline.knownGroups", "expected": 12, "blocking": true },
      { "id": "unknown-rows", "kind": "equals", "description": "3 台待判定设备不进入验证", "target": "baseline.unknownRows", "expected": 3, "blocking": true },
      { "id": "features", "kind": "equals", "description": "只使用三个测量字段", "target": "baseline.featureFields", "expected": ["振动(mm/s)", "轴承温度(°C)", "电流(A)"], "blocking": true },
      { "id": "confusion", "kind": "equals", "description": "3 近邻逐设备留出混淆矩阵", "target": "baseline.confusion", "expected": { "normalCorrect": 12, "normalAsAttention": 0, "attentionAsNormal": 0, "attentionCorrect": 12 }, "blocking": true },
      { "id": "accuracy", "kind": "equals", "description": "合成数据上的准确率，不可外推", "target": "baseline.accuracy", "expected": 1, "blocking": true },
      { "id": "balanced-accuracy", "kind": "equals", "description": "合成数据上的平衡准确率，不可外推", "target": "baseline.balancedAccuracy", "expected": 1, "blocking": true },
      { "id": "unknown-predictions", "kind": "equals", "description": "三台待判定设备仅有参考预测", "target": "baseline.predictions", "expected": [{ "device": "U01", "label": "正常" }, { "device": "U02", "label": "关注" }, { "device": "U03", "label": "关注" }], "blocking": true },
      { "id": "drop-temperature", "kind": "equals", "description": "删除温度后边界样本 U03 参考类别变化", "target": "baseline.removedFieldPredictions.轴承温度(°C)", "expected": ["正常", "关注", "正常"], "blocking": true }
    ],
    "requiredOutputs": ["text", "table", "plot", "saved-workspace"]
  },
  "blockers": ["工作表缺失或字段单位误读", "分组泄漏或标准化泄漏", "指标与混淆矩阵不一致", "把合成预测当真实诊断"]
}
