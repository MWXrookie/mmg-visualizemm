      { "quote": "请建立透明、可复现的二分类参考方法", "role": "objective" },
      { "quote": "验证时必须以设备为组逐台留出", "role": "constraint" },
      { "quote": "“字段说明”表给出单位与取值含义", "role": "given" }
    ],
    "requiredPoints": ["区分已标注与待判定样本", "按设备分组验证", "标准化仅拟合训练折", "只使用三个测量字段", "参考预测不是安全诊断"]
  },
  "evidence": [
    { "problemQuote": "“已标注巡检”表给出 12 台设备各 2 次巡检", "file": "attachments/巡检数据.xlsx", "sheet": "已标注巡检", "fields": ["设备编号", "振动(mm/s)", "轴承温度(°C)", "电流(A)", "状态"] },
    { "problemQuote": "“待判定巡检”表给出 3 台新设备的观测", "file": "attachments/巡检数据.xlsx", "sheet": "待判定巡检", "fields": ["设备编号", "振动(mm/s)", "轴承温度(°C)", "电流(A)"] },
    { "problemQuote": "“字段说明”表给出单位与取值含义", "file": "attachments/巡检数据.xlsx", "sheet": "字段说明", "fields": ["字段", "说明"] }
  ],
  "modeling": {
    "requiredConcepts": ["分组留出", "训练集标准化", "混淆矩阵", "平衡准确率", "特征删除敏感性"],
    "acceptableAlternatives": ["可使用其他透明分类器，但必须保留设备分组和无泄漏预处理", "可使用按设备汇总后的特征，但须说明改变了预测单位"],
    "forbiddenClaims": ["同一设备观测同时进入训练与验证", "把设备编号或状态作为数值特征", "把待判定预测当真值", "宣称真实设备安全或故障诊断"],
    "risks": ["合成类别差异较清晰，验证表现不能外推", "边界附近的 U03 对建模选择可能敏感", "两次巡检之间并非独立设备"]
  },
  "execution": {
